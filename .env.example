# ZYROX ARENA — ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env and set your real project keys for cross-device live sync!

# 1. Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Cloudflare Worker API URL (Production API worker)
VITE_WORKER_API_URL=https://zyrox-arena-api.darshittaank.workers.dev

# 3. Secret Admin Route Path (e.g. control-panel-dev)
VITE_ADMIN_PATH=control-panel-dev
